]>

<model code="QUERY_STATISTICS_003" description="Load Profile by Quartile">
    <parameters/>
    <orders/>
    <columns/>
    <query_text><![CDATA[SELECT 
    quartil,
    ROUND(SUM(total_ms)::numeric, 2) as total_ms_acumulados,
    COUNT(*) as qtd_queries_no_grupo,
    ROUND(AVG(calls)::numeric, 0) as media_chamadas_por_query,
    ROUND(MAX(total_ms)::numeric, 2) as max_ms_uma_unica_query_gastou
FROM (
    SELECT 
        s.total_exec_time as total_ms,
        s.calls,
        ntile(4) OVER (ORDER BY s.total_exec_time) as quartil
    FROM pg_stat_statements s
    JOIN pg_database d ON s.dbid = d.oid
    WHERE d.datname = current_database() -- Filtra apenas a base atual
) t
GROUP BY quartil
ORDER BY quartil;
]]></query_text>
    <database_request><![CDATA[yes]]></database_request>
    <output_type><![CDATA[Text]]></output_type>
    <model_path><![CDATA[/Query Statistics/]]></model_path>
</model>